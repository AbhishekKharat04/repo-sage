# ShipSage Environment Template
# This file is a template. Do NOT commit the actual .env file to version control.

# Application Configuration
APP_ENV=production
PORT=8000
DEBUG=false
LOG_LEVEL=info

# API Keys (Add your actual keys in the .env file)
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub Token (For higher API rate limits during analysis)
GITHUB_TOKEN=your_github_personal_access_token

# Database/Storage (If applicable)
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./shipsage.db
